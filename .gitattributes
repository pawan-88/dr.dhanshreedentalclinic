# Normalise line endings so Git stops warning about LF -> CRLF conversion
# and so the repo stays consistent across Windows and the Linux build machines
# that Vercel and Netlify use.

* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe can mis-parse them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets - never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
